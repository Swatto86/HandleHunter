// HandleHunter.rc - Application Resources

#include <windows.h>
#include "resource.h"

// Application Icon
IDI_APP_ICON ICON "icon.ico"

// Embed the application manifest
1 RT_MANIFEST "manifest.xml"

// Accelerator table for keyboard shortcuts
IDC_ACCEL_REFRESH ACCELERATORS
BEGIN
    VK_F5, IDC_REFRESH_BTN, VIRTKEY
    VK_DELETE, IDC_RELEASE_BTN, VIRTKEY
END

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Steve Watson"
            VALUE "FileDescription",  "Lightweight Windows utility for managing file locks"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "HandleHunter"
            VALUE "LegalCopyright",   "Copyright (C) 2025 Steve Watson"
            VALUE "OriginalFilename", "HandleHunter.exe"
            VALUE "ProductName",      "HandleHunter"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
